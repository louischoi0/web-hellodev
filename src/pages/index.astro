---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContractGuide from '../components/ContractGuide.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import MoreLink from '../components/MoreLink.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../site';

const fit = [
  {
    situation: '개발자 채용이 계속 늦어지고 있다',
    pain: '채용 공고를 올린 지 몇 달이 지났는데 출시 일정은 그대로 밀리고 있습니다.',
    answer: '채용 없이 숙련된 FDE 1명이 바로 합류해 다음 출시까지 주도합니다.',
  },
  {
    situation: '외주를 맡겼는데 결과물이 요구와 다르다',
    pain: '기획 의도가 개발사에 전달되는 과정에서 달라지고, 수정할 때마다 비용과 일정이 늘어납니다.',
    answer: '기획부터 개발까지 한 사람이 맡아 전달 단계가 없고, 결과물을 마일스톤마다 확인합니다.',
  },
  {
    situation: '아이디어를 빠르게 검증해야 한다',
    pain: '내부 개발 리소스를 받으려면 분기를 기다려야 하고, 승인이 나기 전에 시장은 움직입니다.',
    answer: '2주 동안 실제 업무를 함께 진행해 보고, 계속할지는 그 결과를 보고 결정합니다.',
  },
  {
    situation: '서비스가 느리고, 장애가 반복된다',
    pain: '원인을 아는 사람이 떠났거나 없어서, 같은 문제가 다시 발생해도 손을 대기 어렵습니다.',
    answer: '현장에서 직접 원인을 찾고, 개선 전후의 수치를 함께 확인합니다.',
  },
];
const strengths = [
  { area: '금융', body: '틀리면 안 되는 거래와 정산 시스템을 다뤄 온 경험으로, 정확성과 안정성이 필요한 서비스를 설계합니다.' },
  { area: '분산 네트워크', body: '서버 한 대가 멈춰도 서비스가 계속 동작하도록, 여러 노드에 걸친 구조를 설계하고 운영합니다.' },
  { area: '데이터베이스', body: '데이터 모델링부터 쿼리 성능까지 직접 다뤄, 서비스가 커져도 느려지지 않는 저장 구조를 만듭니다.' },
  { area: '대규모 트래픽', body: '사용자가 몰리는 순간의 지연 시간과 장애를 직접 겪고 해결한 경험으로, 부하를 견디는 서비스를 만듭니다.' },
  { area: 'AI 도구', body: 'AI 도구를 개발 과정 전반에 전문적으로 활용해, 같은 기간에 더 넓은 범위를 검증된 품질로 구현합니다.' },
];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
---
<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="display">2주동안 무료로<br />FDE<span class="gloss">(현장 배치 엔지니어)</span>와 함께 협업해보세요.</h1>
      <p class="lead">FDE(Forward Deployed Engineer)는 고객의 업무 현장에 직접 합류해 문제를 정의하고, 해결책을 설계부터 배포까지 직접 구현하는 엔지니어입니다.</p>
      <ul class="points">
        <li><strong>전문 기술 개발자 1명이 프로젝트를 설계하고 주도합니다.</strong> 요구사항 정리, 아키텍처 설계, 개발, 배포까지 한 사람이 책임지므로 전달 과정에서 생기는 누락과 지연이 없습니다.</li>
        <li><strong>처음 2주는 무료입니다.</strong> 실제 업무를 함께 진행해 보고 계속할지 결정하실 수 있습니다.</li>
        <li><strong>프로젝트별로 계약합니다.</strong> 필요한 범위만큼 계약하고, 프로젝트가 끝나면 계약도 함께 끝납니다.</li>
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href="/projects/">포트폴리오 보기 <span class="chev" aria-hidden="true">›</span></a>
        <a class="btn btn-secondary" href="#contact">프로젝트 문의</a>
      </div>
    </div>
    <svg class="motif" viewBox="0 0 168 48" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => <polyline points={`${8 + i * 32},8 ${24 + i * 32},24 ${8 + i * 32},40`} />)}
    </svg>
  </section>

  <section id="about" class="section">
    <div class="wrap">
      <SectionHeader eyebrow="About" title="설계부터 운영까지" />
      <ContractGuide />
    </div>
  </section>

  <section id="fit" class="section">
    <div class="wrap">
      <SectionHeader eyebrow="Who it's for" title="이런 상황이라면 지금이 적기입니다">
        <p class="muted">예산과 결정권을 가진 분이 직접 판단해야 하는 프로젝트를 위해 만든 방식입니다.</p>
      </SectionHeader>
      <ul class="fit">
        {fit.map((f) => (
          <li>
            <div class="who">
              <h3>{f.situation}</h3>
            </div>
            <div class="why">
              <p>{f.pain}</p>
              <p class="answer">{f.answer}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="fit-cta">
        <p class="h3">하나라도 해당된다면, 2주 무료 협업으로 먼저 확인해 보세요.</p>
        <a class="btn btn-primary" href="#contact">무료 2주 문의 <span class="chev" aria-hidden="true">›</span></a>
      </div>
    </div>
  </section>

  <section id="why" class="section">
    <div class="wrap">
      <SectionHeader eyebrow="Why 헬로월드" title="헬로월드가 해결할 수 있는 이유">
        <p class="lead-sm">10년 이상 금융, 분산 네트워크, 데이터베이스, 대규모 트래픽 서비스를 개발해 온 개발자가 AI 도구에 대한 전문 지식까지 갖췄기 때문입니다.</p>
      </SectionHeader>
      <ul class="fit">
        {strengths.map((f) => (
          <li>
            <div class="who">
              <h3>{f.area}</h3>
            </div>
            <div class="why">
              <p class="answer">{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="story-close">경험이 판단하고, AI가 속도를 냅니다.<br />그래서 한 사람이 설계부터 운영까지 책임질 수 있습니다.</p>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="wrap contact-inner">
      <div class="contact-copy">
        <p class="label eyebrow-on-navy">Contact</p>
        <h2>함께 만들 서비스가 있다면 알려 주세요.</h2>
        <p class="contact-lead">회사 규모, 직무, 문의 내용과 답장을 받을 이메일을 남겨 주세요. 확인 후 입력하신 이메일로 직접 답장드립니다. 보통 이틀 안에 답장합니다.</p>
      </div>
      <InquiryForm />
    </div>
  </section>

  <section id="projects" class="section">
    <div class="wrap">
      <SectionHeader eyebrow="Projects" title="포트폴리오" />
      <ProjectGrid projects={projects} />
      <MoreLink href="/projects/">전체 포트폴리오 보기</MoreLink>
    </div>
  </section>

</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-inner { display: grid; gap: var(--space-24); padding-block: var(--space-64); position: relative; z-index: 1; }
  .eyebrow { color: var(--orange-ink); }
  .hero h1 { max-width: 14em; }
  .gloss {
    font-size: 0.4em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-muted);
    vertical-align: 0.6em;
    margin-inline: 0.15em;
  }
  .lead { font-size: 19px; line-height: 32px; color: var(--ink-muted); max-width: var(--text-max); }
  .points { display: grid; gap: var(--space-16); margin: 0; padding: 0; list-style: none; max-width: var(--text-max); }
  .points li { position: relative; padding-left: var(--space-24); color: var(--ink-muted); }
  .points li::before {
    content: '›';
    position: absolute;
    left: 4px;
    color: var(--orange-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .points strong { color: var(--ink); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-16); margin-top: var(--space-8); }
  .motif {
    position: absolute;
    right: max(var(--space-16), calc((100vw - var(--content-max)) / 2));
    bottom: var(--space-40);
    width: 240px;
    max-width: 40%;
    fill: none;
    stroke: var(--orange);
    stroke-width: 4;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  @media (max-width: 639px) { .motif { display: none; } }


  .fit { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .fit li { display: grid; gap: var(--space-16); padding-block: var(--space-40); border-bottom: 1px solid var(--line); }
  @media (min-width: 768px) { .fit li { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-40); } }
  .who { align-content: start; }
  .why { display: grid; gap: var(--space-8); max-width: var(--text-max); }
  .why p { color: var(--ink-muted); }
  .why .answer { color: var(--ink); font-weight: 500; }
  .story-close {
    max-width: var(--text-max);
    margin-top: var(--space-40);
    padding-top: var(--space-24);
    border-top: 2px solid var(--orange);
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 34px;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }
  @media (max-width: 639px) { .story-close { font-size: 21px; line-height: 30px; } }
  .lead-sm { font-size: 19px; line-height: 32px; color: var(--ink-muted); margin-top: var(--space-8); }
  .fit-cta { display: grid; gap: var(--space-16); justify-items: start; margin-top: var(--space-40); }
  .contact { background: var(--navy); color: var(--on-navy); }
  .contact h2 { color: var(--on-navy); }
  .contact-inner { display: grid; gap: var(--space-40); }
  .contact-copy { display: grid; gap: var(--space-24); align-content: start; }
  @media (min-width: 960px) { .contact-inner { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-64); } }
  .eyebrow-on-navy { color: var(--orange); }
  .contact-lead { max-width: var(--text-max); color: var(--on-navy-muted); }
</style>
