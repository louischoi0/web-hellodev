---
interface Props {
  title: string;
  outcome: string;
  stack: string[];
  year: number;
  href?: string;
}
const { title, outcome, stack, year, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag class="card" href={href}>
  <div class="head">
    <span class="label muted">{year}</span>
    <h3>{title}</h3>
  </div>
  <div class="body">
    <p class="outcome">{outcome}</p>
    <ul class="tags">
      {stack.map((s) => <li class="tag label">{s}</li>)}
    </ul>
    {href && <span class="more">사례 연구 읽기 <span aria-hidden="true">›</span></span>}
  </div>
</Tag>

<style>
  .card {
    display: grid;
    gap: var(--space-16);
    padding-block: var(--space-40);
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .card { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-40); }
  }
  .head { display: grid; gap: var(--space-8); align-content: start; }
  .body { display: grid; gap: var(--space-16); justify-items: start; }
  .outcome { color: var(--ink); }
  .more { color: var(--orange-ink); font-weight: 600; }
  h3 { transition: color 150ms ease-out; }
  a.card:hover h3 { color: var(--orange-ink); }
  a.card:hover .more { text-decoration: underline; }
</style>
