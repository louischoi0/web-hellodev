---
// Long-form layout for project case studies.
interface Props {
  eyebrow: string;
  title: string;
  meta?: string;
  back: { href: string; label: string };
}
const { eyebrow, title, meta, back } = Astro.props;
---
<article class="section">
  <div class="wrap">
    <div class="article">
      <a class="back body-sm" href={back.href}><span aria-hidden="true">‹</span> {back.label}</a>
      <header class="head">
        <p class="label eyebrow">{eyebrow}</p>
        <h1 class="h1">{title}</h1>
        {meta && <p class="label muted">{meta}</p>}
        <slot name="head" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .article { max-width: var(--text-max); margin-inline: auto; display: grid; gap: var(--space-40); }
  .back { color: var(--ink-muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .head { display: grid; gap: var(--space-16); }
  .eyebrow { color: var(--orange-ink); }
  .h1 { font-size: 40px; line-height: 48px; font-weight: 700; letter-spacing: -0.015em; }
  @media (max-width: 639px) { .h1 { font-size: 32px; line-height: 40px; } }

  .prose { font-size: 18px; line-height: 31px; display: grid; gap: var(--space-16); min-width: 0; }
  .prose :global(h2) { margin-top: var(--space-24); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0; }
  .prose :global(ul) { padding-left: 0; list-style: none; display: grid; gap: var(--space-8); }
  .prose :global(ul li) { position: relative; padding-left: var(--space-24); }
  .prose :global(ul li)::before {
    content: '›';
    position: absolute;
    left: 4px;
    color: var(--orange-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; }
  .prose :global(:not(pre) > code) { padding: 1px var(--space-4); border-radius: var(--radius-sm); background: var(--surface-200); border: 1px solid var(--line); }
  .prose :global(pre) {
    margin: 0;
    padding: var(--space-16);
    overflow-x: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-size: 14px;
    line-height: 22px;
  }
</style>
