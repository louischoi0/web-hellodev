---
import { site, nav } from '../site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <div class="info body-sm">
      <p class="name">{site.name}</p>
      <p>사업자등록번호 {site.business.registration} · {site.business.address}</p>
      <p>© {year} {site.name}</p>
    </div>
    <ul class="body-sm">
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-24); padding-block: var(--space-40); color: var(--ink-muted); }
  .info { display: grid; gap: var(--space-4); }
  .name { font-family: var(--font-display); font-weight: 700; color: var(--ink); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-24); margin: 0; padding: 0; list-style: none; }
  a { color: var(--ink-muted); text-decoration: none; }
  a:hover { color: var(--ink); }
</style>
