---
interface Props {
  eyebrow: string;
  title: string;
  // The page's main heading uses 1; it keeps the h2 look.
  level?: 1 | 2;
}
const { eyebrow, title, level = 2 } = Astro.props;
---
<header class="section-header">
  <p class="label eyebrow">{eyebrow}</p>
  {level === 1 ? <h1 class="h2">{title}</h1> : <h2>{title}</h2>}
  <slot />
</header>

<style>
  .section-header { display: grid; gap: var(--space-8); margin-bottom: var(--space-40); max-width: var(--text-max); }
  .eyebrow { color: var(--orange-ink); }
</style>
