---
import { site, nav } from '../site';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="links">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <details class="menu">
        <summary>Menu</summary>
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close the phone menu after choosing an in-page link.
  document.querySelectorAll('.menu a').forEach((a) =>
    a.addEventListener('click', () => (a.closest('details') as HTMLDetailsElement).removeAttribute('open')),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--surface-100) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-24); height: var(--header-h); }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--ink); text-decoration: none; }
  ul { margin: 0; padding: 0; list-style: none; }
  .links { display: flex; gap: var(--space-24); }
  nav a {
    position: relative;
    display: inline-block;
    padding: var(--space-4) 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current] { color: var(--orange-ink); }
  .links a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--orange);
  }
  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-8) var(--space-16);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 500;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-8));
    min-width: 200px;
    display: grid;
    padding: var(--space-8);
    background: var(--surface-200);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .menu ul a { display: block; padding: var(--space-8) var(--space-16); }
  @media (max-width: 639px) {
    .links { display: none; }
    .menu { display: block; }
  }
</style>
