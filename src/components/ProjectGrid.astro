---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p) => (
    <ProjectCard
      title={p.data.title}
      outcome={p.data.outcome}
      stack={p.data.stack}
      year={p.data.year}
      href={p.data.caseStudy ? `/projects/${p.id}/` : undefined}
    />
  ))}
</div>

<style>
  .grid { display: grid; }
  .grid > :global(:first-child) { padding-top: 0; }
</style>
